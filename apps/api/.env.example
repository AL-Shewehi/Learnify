NODE_ENV=development
PORT=5000
MONGODB_URL=mongodb://127.0.0.1:27017/learnify
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Print password-reset emails to the terminal during local development.
DEVELOPMENT=true

# Required for real email delivery when DEVELOPMENT=false.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=Learnify <noreply@example.com>
